OMNIDECK_PLANNER_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_TIMEOUT_MS=30000
# DEEPSEEK_TEMPERATURE=0.1

# Real-device desktop/dev mode is opt-in. Prefer `npm run desktop:dev:android`
# for local Android testing because it auto-detects authorized ADB devices.
# OMNIDECK_ENABLE_REAL_DEVICES=true
# OMNIDECK_ANDROID_DRIVER_MODE=ANDROID_ADB_SCRCPY
# OMNIDECK_ANDROID_SERIALS=63c7a9c9
# OMNIDECK_START_SCRCPY_PROCESS=false
