{
  "name": "omnideck-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:daemon\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:daemon": "tsx watch src/server/index.ts",
    "start:daemon": "tsx src/server/index.ts",
    "smoke:android-actions": "tsx scripts/android-action-smoke.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
